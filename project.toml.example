# .claude/project.toml — このリポジトリ固有の設定
#
# ai-dev プラグインと reusable workflow は、この1ファイルだけを見て
# 「このプロジェクトで何を守るか」を判断する。
# テンプレート側(汎用の仕組み)は追従させ、ここは追従させない。

[project]
name = "your-project"
# fixer が修正後に必ず通す検証コマンド。人間・AI・CIが同じものを叩く
check_command = "mise run check"

# ---------------------------------------------------------------------
# 聖域 — AIが単独で変更してはいけない領域
#
# ここに書いたパスへの編集は、ローカルでは確認(ask)を挟み、
# CIでは fixer を起動せず needs-human ラベルに回す。
#
# **path が実在しないと docs_lint がエラーで落ちる。**
# 「設定し忘れてガードが空振りしているのに気づかない」を防ぐため。
# ---------------------------------------------------------------------

[[sanctuary.rule]]
path = "config/config.toml"
# 任意。この正規表現に当たる編集だけ止める(無指定ならファイル全体)
match = "\\b(watch|alert|crisis)\\s*="
reason = "この値は判断そのもの。根拠がADR・PRの説明に書かれているか確認してから進めること"

[[sanctuary.rule]]
path = "src/rules.py"
# 任意。この文字列を含む編集だけ止める
symbols = ["def evaluate(", "def decide("]
reason = "判定の心臓部。意味を変える変更は先に Plan PR とドキュメントを通すこと"

# ---------------------------------------------------------------------
# 保存時 lint — 編集直後に違反を知らせる(ブロックはしない)
# ---------------------------------------------------------------------

[[lint.rule]]
ext = ".py"
command = ["uv", "run", "ruff", "check"]
fix_hint = "mise run fix"

# [[lint.rule]]
# ext = ".ts"
# command = ["npx", "eslint"]

# ---------------------------------------------------------------------
# 受け入れケース台帳 <-> テストの双方向突合
#
# 台帳に載っているIDがテストに無い / テストにあるIDが台帳に無い、を両方落とす。
# 設定しなければこの検査はスキップされる。
# ---------------------------------------------------------------------

[acceptance]
ledger = ".claude/05_acceptance/01_scope.md"
tests_dir = "tests"
test_globs = ["*.py"]

# ---------------------------------------------------------------------
# 連番規約(NN_slug.md、2桁ゼロ埋め、重複なし)を検査するディレクトリ
# ---------------------------------------------------------------------

[numbering]
dirs = [".claude/06_adr", ".claude/07_plans"]

# ---------------------------------------------------------------------
# ドキュメント内リンクの参照切れを検査するディレクトリ
# ---------------------------------------------------------------------

[docs]
link_check_dir = ".claude"

# ---------------------------------------------------------------------
# レビューの判断基準(reviewer / plan-reviewer が読む)
# ---------------------------------------------------------------------

[review]
checklist = ".claude/04_quality/01_review_checklist.md"
severity = ".claude/04_quality/02_severity.md"

[plan]
template = ".claude/00_project/03_plan_template.md"

# ---------------------------------------------------------------------
# プロジェクト固有の検査(拡張点)
#
# 汎用の docs_lint で表現しきれない検査は、自前のスクリプトに書いて
# ここで指定する。docs_lint はこれを実行し、終了コードを引き継ぐ。
# 例: 設定ファイルのスキーマ検証、ドメイン固有の整合性チェック
# ---------------------------------------------------------------------

# [checks]
# extra = ".github/scripts/project_checks.py"
